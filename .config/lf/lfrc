map xx extract
map xr source ~/.config/lf/lfrc
map zp toggle-preview
map gs :fzf_search
map f :filter
map a :push %touch<space>
map A :push %mkdir<space>
map r :rename
map <delete> delete
map <c-up> :half-up
map <c-down> :half-down
